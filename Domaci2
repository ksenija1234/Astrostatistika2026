    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import bootstrap, norm\n",
    "\n",
    "uzorak_all = exo[\"st_met\"].dropna() \n",
    "uzorak = exo[exo[\"st_met\"] > 0.4][\"st_met\"] #uzimam deo uzorka cija je metalicnost veca od 0.4\n",
    "\n",
    "N = 1000  # broj bootstrap resamplova\n",
    "\n",
    "rez_mean = bootstrap( #bootstrap za mean\n",
    "    (uzorak.values,),\n",
    "    np.mean,\n",
    "    n_resamples=N,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "mean_boot = rez_mean.bootstrap_distribution\n",
    "\n",
    "rez_std = bootstrap( #bootstrap za std\n",
    "    (uzorak.values,),\n",
    "    lambda x: np.std(x, ddof=1),\n",
    "    n_resamples=N,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "std_boot = rez_std.bootstrap_distribution\n",
    "\n",
    "s = np.std(uzorak, ddof=1) #analiticke procene\n",
    "n = len(uzorak)\n",
    "\n",
    "sigma_x_boot = np.std(mean_boot)\n",
    "sigma_s_boot = np.std(std_boot)\n",
    "\n",
    "sigma_x_anal = s / np.sqrt(n)\n",
    "sigma_s_anal = s / np.sqrt(2 * (n - 1))\n",
    "\n",
    "print(\"bootstrap:\")\n",
    "print(\"sigma mean:\", sigma_x_boot)\n",
    "print(\"sigma s:\", sigma_s_boot)\n",
    "\n",
    "print(\"analiticke:\")\n",
    "print(\"sigma mean:\", sigma_x_anal)\n",
    "print(\"sigma s:\", sigma_s_anal)\n",
    "\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.hist(mean_boot, bins=50, density=True, alpha=0.6, color=\"#ff1d9e\") #histogram\n",
    "\n",
    "x = np.linspace(mean_boot.min(), mean_boot.max(), 200)\n",
    "plt.plot(x, norm.pdf(x, np.mean(uzorak), sigma_x_anal), color='#22ff7b') #plotujem krivu\n",
    "\n",
    "plt.title(\"Bootstrap distribucija srednje vrijednosti\")\n",
    "plt.xlabel(\"mean\")\n",
    "plt.ylabel(\"density\")\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.hist(std_boot, bins=50, density=True, alpha=0.7, color=\"#ff1d9e\") #histogram za standardnu devijaciju\n",
    "\n",
    "\n",
    "\n",
    "plt.title(\"Bootstrap distribucija standardne devijacije\")\n",
    "plt.xlabel(\"std\")\n",
    "plt.ylabel(\"density\")\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(10, 4))\n",
    "plt.hist(uzorak_all, bins=50,  color='#ff0054', alpha=0.5, density=True, label=\" \") #distribucija metalicnosti na celom uzorku\n",
    "plt.hist(uzorak, bins=50,  color='#9eff00', alpha=0.5, density=True, label=\"Fe/H > 0.4\") #distribucija metalicnosti na uzorku >0.4\n",
    "\n",
    "plt.title(\"Distribucija metalicnosti\")\n",
    "plt.xlabel(\"st_met\")\n",
    "plt.ylabel(\"density\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
